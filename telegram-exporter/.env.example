# --- required -------------------------------------------------------------
# From https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# From @BotFather
BOT_TOKEN=123456789:AAExampleExampleExampleExampleExam
# Your numeric Telegram user id (login.py prints it). Only this user can use the bot.
OWNER_ID=123456789

# --- optional -------------------------------------------------------------
# Where exports, checkpoints and logs are written.
EXPORT_DIR=./exports
# Zip volumes larger than this are split (bots can upload at most 2000 MB per file).
MAX_PART_SIZE_MB=1900
# Keep the export folder and zip on the server after sending (true/false).
KEEP_EXPORTS=false
# Where login.py stores the user session. Must be OUTSIDE the repository.
# Default: ~/.tg-exporter   (Docker: /data/session, set in docker-compose.yml)
# SESSION_DIR=/home/me/.tg-exporter
# Timezone used for dates in the export and for custom date ranges.
TZ=UTC
LOG_LEVEL=INFO
# LOG_DIR defaults to $EXPORT_DIR/logs
